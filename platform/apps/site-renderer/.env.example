# Required browser-facing API origin, embedded during the build.
NEXT_PUBLIC_SITE_API_BASE_URL=http://localhost:8080

# Required server-side origins at runtime.
SITE_API_BASE_URL=http://localhost:8080
SITE_PUBLIC_ORIGIN=http://localhost:3002

# Optional feature gate. Only the exact value "true" enables indexing.
SITE_PUBLIC_INDEXING_ENABLED=false
