# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Third-party API keys
CHAT_GPT_API_KEY=
ELEVEN_LABS_API_KEY=
DEEPGRAM_API_KEY=

# Google OAuth 2.0 (required at startup)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Firestore project selection. Required in every environment; it is never
# inferred from NODE_ENV or Google Cloud project discovery variables.
# Local/DEV example: FIRESTORE_PROJECT_ID=bakerrang-dev
# Production must explicitly name its own project before a future deployment.
FIRESTORE_PROJECT_ID=

# Consumer Launcher origin (CORS, OAuth target=launcher, and the default
# post-login / login-failure destination).
# Production Milestone 1: https://launch.bakerrang.com
LAUNCHER_DOMAIN=
# Storybook App
STORYBOOK_DOMAIN=
POLYGLOT_DOMAIN=
SIGN_DOMAIN=
BUDGET_DOMAIN=
PASSWORDS_DOMAIN=
# Consumer Account app (CORS and OAuth target=account).
# Local dev: http://localhost:3060 - Production: https://account.bakerrang.com
ACCOUNT_DOMAIN=
# This API's own origin (required).
SERVER_DOMAIN=
CHATBOT_ORIGIN=
CHATBOT_VOICE_ID=

# Security secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
CSRF_SECRET=

# Set to "development" for local http testing (relaxes secure/__Host- cookies)
# NODE_ENV=development
