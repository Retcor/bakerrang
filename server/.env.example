# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Third-party API keys
CHAT_GPT_API_KEY=
ELEVEN_LABS_API_KEY=
DEEPGRAM_API_KEY=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Domains / origins
CLIENT_DOMAIN=
SERVER_DOMAIN=
CHATBOT_ORIGIN=
CHATBOT_VOICE_ID=

# Security secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
CSRF_SECRET=

# Set to "development" for local http testing (relaxes secure/__Host- cookies)
# NODE_ENV=development
