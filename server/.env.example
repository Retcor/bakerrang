# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Third-party API keys
CHAT_GPT_API_KEY=
ELEVEN_LABS_API_KEY=
DEEPGRAM_API_KEY=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Google OAuth 2.0 (required at startup)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Firestore project selection. Required in every environment; it is never
# inferred from NODE_ENV or Google Cloud project discovery variables.
# Local/DEV example: FIRESTORE_PROJECT_ID=bakerrang-dev
# Production must explicitly name its own project before a future deployment.
FIRESTORE_PROJECT_ID=

# Globally unique Google Cloud Storage bucket for public immutable site media.
# Development and production must use different buckets.
MEDIA_BUCKET_NAME=

# Public DRAFT sites are hidden unless this is explicitly true outside
# production. NODE_ENV=production always disables DRAFT visibility.
ALLOW_DRAFT_PUBLIC_SITES=false

# Optional legacy learning-client origin. Set it only when that client needs
# API CORS access; when set, it must be an absolute HTTP/HTTPS origin.
CLIENT_DOMAIN=
# Required browser/API origins; each must be an absolute HTTP/HTTPS origin.
PORTAL_DOMAIN=
# Public renderer origin allowed to submit lead forms in the browser.
# Current local renderer: http://localhost:3002
# ACTIVE custom-domain HTTPS origins are resolved through the domain registry.
SITE_RENDERER_DOMAIN=
SERVER_DOMAIN=
CHATBOT_ORIGIN=
CHATBOT_VOICE_ID=

# Security secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
CSRF_SECRET=
# Required for deployed working-site previews. Use an independent random secret.
PREVIEW_TOKEN_SECRET=

# Lead notification worker. Required in production only. Configure Cloud
# Scheduler to POST /internal/lead-notifications/drain with:
# Authorization: Bearer $INTERNAL_DRAIN_TOKEN
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM=
INTERNAL_DRAIN_TOKEN=

# Set to "development" for local http testing (relaxes secure/__Host- cookies)
# NODE_ENV=development
