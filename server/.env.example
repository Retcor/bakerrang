# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Third-party API keys
CHAT_GPT_API_KEY=
ELEVEN_LABS_API_KEY=
DEEPGRAM_API_KEY=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Firestore project selection.
# LOCAL DEVELOPMENT: required outside production. Use bakerrang-dev so local
# execution cannot silently discover and access the production project.
#   FIRESTORE_PROJECT_ID=bakerrang-dev
# PRODUCTION: may currently remain unset. The application intentionally falls
# back to the existing production project avian-cable-379805 and continues to
# use Application Default Credentials.
FIRESTORE_PROJECT_ID=

# Globally unique Google Cloud Storage bucket for public immutable site media.
# Development and production must use different buckets.
MEDIA_BUCKET_NAME=

# Public DRAFT sites are hidden unless this is explicitly true outside
# production. NODE_ENV=production always disables DRAFT visibility.
ALLOW_DRAFT_PUBLIC_SITES=false

# Domains / origins
CLIENT_DOMAIN=
PORTAL_DOMAIN=
# Public renderer origin allowed to submit lead forms in the browser.
# Current local renderer: http://localhost:3002
# ACTIVE custom-domain HTTPS origins are resolved through the domain registry.
SITE_RENDERER_DOMAIN=
SERVER_DOMAIN=
CHATBOT_ORIGIN=
CHATBOT_VOICE_ID=

# Security secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
CSRF_SECRET=

# Set to "development" for local http testing (relaxes secure/__Host- cookies)
# NODE_ENV=development
